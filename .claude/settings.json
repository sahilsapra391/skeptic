{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/readme-currency.sh\"",
            "timeout": 15,
            "statusMessage": "Checking README is current..."
          }
        ]
      }
    ]
  }
}
