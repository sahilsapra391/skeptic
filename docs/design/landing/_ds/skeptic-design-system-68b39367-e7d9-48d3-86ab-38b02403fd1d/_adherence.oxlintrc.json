{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/composer/**",
              "components/core/**",
              "components/gauntlet/**",
              "components/navigation/**",
              "components/verdict/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Mono|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Mono, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|onClick|title|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, onClick, title, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|secondary|ghost|pill|trustpill)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'secondary' | 'ghost' | 'pill' | 'trustpill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|placeholder|busy|showMic|listening|onMic|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: value, onChange, onSubmit, placeholder, busy, showMic, listening, onMic."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|fill|range|state|key|ref|className|style|children)$/]",
        "message": "<CoverageChip> doesn't accept that prop. Declared props: label, fill, range, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:ok|loading|warn)$/]",
        "message": "<CoverageChip> state must be one of 'ok' | 'loading' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|key|ref|className|style|children)$/]",
        "message": "<DemoBadge> doesn't accept that prop. Declared props: text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclaimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:short|key|ref|className|style|children)$/]",
        "message": "<Disclaimer> doesn't accept that prop. Declared props: short."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stage'] > JSXAttribute > JSXIdentifier[name!=/^(?:t|n|key|ref|className|style|children)$/]",
        "message": "<Stage> doesn't accept that prop. Declared props: t, n."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hint'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|align|key|ref|className|style|children)$/]",
        "message": "<Hint> doesn't accept that prop. Declared props: text, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hint'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|right)$/]",
        "message": "<Hint> align must be one of 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|neg|hint|hintAlign|style|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: value, label, neg, hint, hintAlign, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute[name.name='hintAlign'] > Literal[value!=/^(?:center|right)$/]",
        "message": "<MetricTile> hintAlign must be one of 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|icon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, title, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:plus|library|data|settings)$/]",
        "message": "<NavItem> icon must be one of 'plus' | 'library' | 'data' | 'settings'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|right|padding|style|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, right, padding, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PresetChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|structure|phrase|onClick|key|ref|className|style|children)$/]",
        "message": "<PresetChip> doesn't accept that prop. Declared props: label, structure, phrase, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PulsingDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<PulsingDots> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|question|options|onAnswer|busy|key|ref|className|style|children)$/]",
        "message": "<QuestionCard> doesn't accept that prop. Declared props: index, total, question, options, onAnswer, busy."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|width|key|ref|className|style|children)$/]",
        "message": "<Band> doesn't accept that prop. Declared props: left, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Verdict'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|survived|band|marker|chips|evidence|breaks|caveat|refusal|refusalBody|refusalUnlock|key|ref|className|style|children)$/]",
        "message": "<Verdict> doesn't accept that prop. Declared props: headline, survived, band, marker, chips, evidence, breaks, caveat, refusal, refusalBody, refusalUnlock."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
