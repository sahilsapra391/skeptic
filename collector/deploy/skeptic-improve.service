[Unit]
Description=Skeptic nightly unlock scan (ENGINE-V3 D3, capped auto re-runs)
Documentation=https://github.com/sahilsapra391/skeptic/blob/main/backend/scripts/nightly_improve.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=skeptic
Environment=HOME=/home/skeptic
# nightly_improve.py imports `app.*` from the backend package root, which the
# workflow supplied as PYTHONPATH=. from working-directory: backend.
Environment=PYTHONPATH=/opt/skeptic/backend
WorkingDirectory=/opt/skeptic/backend
# backend/ has its own venv and no .env of its own. app.config.load_local_env()
# would find collector/.env on its own, but pass it explicitly so the unit does
# not depend on that fallback staying put.
# flock: skeptic-autoupdate can fire in this window (03:00 ET + up to 10 min
# jitter = 07:00-07:10 UTC under EDT) and it git-merges /opt/skeptic and runs
# `uv sync` — pulling the tree out from under a running scan. Both units take
# the same lock, so whichever starts second waits instead of racing.
ExecStart=/usr/bin/flock -w 900 /run/lock/skeptic-deploy.lock /usr/local/bin/uv run --env-file /opt/skeptic/collector/.env python scripts/nightly_improve.py --execute
# A failed oneshot alerts nowhere on its own (on Actions a red run emailed).
# Optional per-lane tile: set HEALTHCHECK_URL_IMPROVE in collector/.env and
# this pages; until then it logs. Deliberately NOT the EOD tile, whose meaning
# must stay "tonight's lake is whole".
ExecStopPost=/usr/bin/bash /opt/skeptic/collector/deploy/hc-fail.sh skeptic-improve HEALTHCHECK_URL_IMPROVE
# The scan only DECIDES what to re-run; the Railway backend executes via
# POST /api/backtest. Re-runs are capped in the script, so this stays short.
# The flock wait counts against this wall, hence 900 < 1200.
TimeoutStartSec=1200
StandardOutput=append:/var/log/skeptic/improve.log
StandardError=append:/var/log/skeptic/improve.log
