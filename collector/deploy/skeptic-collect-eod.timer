[Unit]
Description=Skeptic nightly EOD collection (21:30 UTC + 22:30 UTC catch-up, Mon-Fri)

[Timer]
# Deliberately UTC, not America/New_York: these are the exact two crons the
# GitHub workflow carried, so the Healthchecks check keeps its existing
# schedule and grace with no dashboard edit and the move stays invisible to
# monitoring. The run lands 4:30-5:30pm ET across DST, always >=30 min after
# the 4:00pm ET close. (systemd 249 on the VM; timezone suffixes need 242+.)
OnCalendar=Mon-Fri *-*-* 21:30:00 UTC
OnCalendar=Mon-Fri *-*-* 22:30:00 UTC
# Deliberately NOT Persistent. A replay fires at boot, which can be any hour,
# and a mid-session run would write a partial chain as if it were the close.
# A genuinely missed 21:30 is already covered by the 22:30 catch-up, which
# no-ops if the day's record objects exist — the same safety net cron had.
Persistent=false

[Install]
WantedBy=timers.target
