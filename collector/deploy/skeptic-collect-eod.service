[Unit]
Description=Skeptic nightly EOD collection (AV chain + minute top-up + derivations)
Documentation=https://github.com/sahilsapra391/skeptic/blob/main/docs/DATA-PIPELINE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=skeptic
# systemd does set HOME from passwd for User=, but autoupdate.sh was stalled for
# three days by exactly this class of bug ("fatal: $HOME not set"), so pin it.
Environment=HOME=/home/skeptic
WorkingDirectory=/opt/skeptic/collector
ExecStart=/usr/bin/bash /opt/skeptic/collector/deploy/collect-eod.sh
# The workflow capped at 45 min; keep the same wall so a wedged AV or R2 call
# can never overlap the 22:30 catch-up or reach the 03:00 ET autoupdate.
TimeoutStartSec=2700
StandardOutput=append:/var/log/skeptic/collect-eod.log
StandardError=append:/var/log/skeptic/collect-eod.log
