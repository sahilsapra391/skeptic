# Local credentials for collector scripts run on the owner's Mac
# (the intraday recorder, or manual collect.py/alpaca.py runs).
# Copy to collector/.env and fill in — .env is gitignored; keys never enter git.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Only needed for manual alpaca.py runs from this machine:
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

# Intraday recorder runaway-write guard: pause writes when options_intraday/
# exceeds this many GB. Leave unset (or <= 0) to disable it, so the recorder
# never pauses on lake size. A blank value also counts as unset. R2 is paid
# (~$0.015/GB-mo), so set this only if you want the lake bounded; e.g. 100
# gives roughly a year of runway before it would trip.
# INTRADAY_MAX_GB=100
