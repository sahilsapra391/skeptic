# Local credentials for collector scripts run on the owner's Mac
# (the intraday recorder, or manual collect.py/alpaca.py runs).
# Copy to collector/.env and fill in — .env is gitignored; keys never enter git.
#
# This same file is what the collector VM runs on (scp'd to
# /opt/skeptic/collector/.env). Since 2026-08-04 the VM also owns the three
# scheduled jobs that used to live in GitHub Actions, so the vars that used to
# exist ONLY as repo secrets now have to be present here too — they are marked
# "VM scheduled jobs" below. autoupdate.sh can never deliver a secret; adding
# one is always a manual edit on the box.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Nightly EOD chain (collect.py --mode all). Was a repo secret only.
ALPHAVANTAGE_API_KEY=

# VM scheduled jobs — skeptic-collect-eod.timer.
# HEALTHCHECK_URL is the dead-man's switch for the nightly run: collect.py
# pings it on success and <url>/fail on error. Without it the run still works
# but nothing watches it, which is how a silent failure goes unnoticed.
# Recover the value from the check's page on healthchecks.io.
HEALTHCHECK_URL=
# Minute-lake top-up (alpaca.py --mode eod). Alpaca paper keys.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# VM scheduled jobs — skeptic-improve.timer (backend/scripts/nightly_improve.py).
# The scan reads the runs DB and submits capped re-runs to the Railway backend.
DATABASE_URL=
SKEPTIC_API_URL=
SKEPTIC_ACCESS_TOKEN=

# Intraday recorder runaway-write guard: pause writes when options_intraday/
# exceeds this many GB. Leave unset (or <= 0) to disable it, so the recorder
# never pauses on lake size. A blank value also counts as unset. R2 is paid
# (~$0.015/GB-mo), so set this only if you want the lake bounded; e.g. 100
# gives roughly a year of runway before it would trip.
# INTRADAY_MAX_GB=100
